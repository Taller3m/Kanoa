{
  "name": "prototipo-juegos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "sync:ui": "node -e \"const fs=require('fs');for(const f of ['ui/index.tsx','ui/ui.css','foundation.css','kanoa-tokens.css']){fs.mkdirSync('src/'+f.split('/').slice(0,-1).join('/'),{recursive:true});fs.copyFileSync('../design-system-studia/src/'+f,'src/'+f)}\""
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
